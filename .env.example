# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3000
HOST=localhost

# AI Provider Selection
# Options: gemini, claude, flux, stable-diffusion, mock
DEFAULT_TEXT_PROVIDER=mock
DEFAULT_IMAGE_PROVIDER=mock

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# Anthropic Claude Configuration
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-sonnet-20240229
CLAUDE_MAX_TOKENS=4096

# FLUX Image Generation Configuration
FLUX_API_KEY=your_flux_api_key_here
FLUX_API_URL=https://api.bfl.ml
FLUX_MODEL=flux-pro

# Stable Diffusion Configuration
STABLE_DIFFUSION_API_KEY=your_sd_api_key_here
STABLE_DIFFUSION_API_URL=http://localhost:7860
STABLE_DIFFUSION_MODEL=sd-xl-base-1.0

# Mock Provider Settings
MOCK_RESPONSE_DELAY=1000

# Canvas Configuration
MAX_CANVAS_WIDTH=4096
MAX_CANVAS_HEIGHT=4096
DEFAULT_CANVAS_WIDTH=1920
DEFAULT_CANVAS_HEIGHT=1080

# Asset Storage
ASSET_STORAGE_PATH=./user-assets
MAX_ASSET_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Feature Flags
ENABLE_VIDEO_GENERATION=false
ENABLE_GAME_ENGINE=false
ENABLE_COLLABORATION=false
